# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Halo PSA
HALO_BASE_URL=https://your-instance.halopsa.com
HALO_CLIENT_ID=your_client_id
HALO_CLIENT_SECRET=your_client_secret
# Halo tenant (some instances need this)
HALO_TENANT=your_tenant

# NinjaRMM
NINJA_BASE_URL=https://app.ninjarmm.com
NINJA_CLIENT_ID=your_client_id
NINJA_CLIENT_SECRET=your_client_secret
# NinjaRMM region: eu, us, oc, ca
NINJA_REGION=eu

# Server
PORT=3001
NODE_ENV=development

# Frontend (set to your Railway/Docker public URL in production)
FRONTEND_URL=http://localhost:5173
