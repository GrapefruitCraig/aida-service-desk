# ── Model (via OpenRouter, OpenAI-compatible) ───────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

# ── Halo PSA ────────────────────────────────────────────────────────────────
HALO_BASE_URL=https://your-instance.halopsa.com
HALO_CLIENT_ID=your_client_id
HALO_CLIENT_SECRET=your_client_secret
# Some instances require a tenant
HALO_TENANT=

# Agent ID of the AIDA account in Halo — used for ownership checks
# (agent stands down if the ticket is reassigned to a human)
T3C_HALO_AGENT_ID=
# Team ID escalations are assigned to
T3C_ESCALATION_TEAM_ID=
# Status IDs on YOUR Halo instance — verify these, they vary per instance
HALO_STATUS_NEW=1
HALO_STATUS_IN_PROGRESS=2
HALO_STATUS_AWAITING_USER=3
HALO_STATUS_RESOLVED=4
HALO_STATUS_CLOSED=5

# ── NinjaRMM ────────────────────────────────────────────────────────────────
NINJA_CLIENT_ID=your_client_id
NINJA_CLIENT_SECRET=your_client_secret
# eu | us | oc | ca (or set NINJA_BASE_URL to override)
NINJA_REGION=eu

# ── Service ─────────────────────────────────────────────────────────────────
PORT=3002
# Shared secret Halo webhooks must send in the X-T3C-Token header
T3C_WEBHOOK_SECRET=change-me
# Directory for the SQLite database (mount a persistent volume in production)
DATA_DIR=./data

# Display name the agent signs ticket notes and user emails with
AGENT_NAME=AIDA

# Shadow mode: full process runs, but user emails / status changes /
# escalations / device actions are written as [SHADOW] private notes instead
T3C_SHADOW_MODE=true

# ── Policy ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=3
MAX_TOOL_ITERATIONS=16
# Hours of user silence before a nudge; nudges before close-no-response
NUDGE_HOURS=24
MAX_NUDGES=2
# Hours after "please confirm it's fixed" before auto-close
CONFIRM_CLOSE_HOURS=72
